{%- liquid
    assign full_width_section = section.settings.full_width_section
    assign banner = section.settings.banner_image
    assign heading_text = section.settings.heading_text
    assign desciption_text = section.settings.description_text
-%}

<div class="hero-banner page-width {% if full_width_section %}page-width--full{% endif %}">
    <div class="hero-banner__image image-wrapper">
        {% if banner != blank %}
            {{ banner | image_url: width: 1000 | image_tag }}
        {% else %}
            {{ "hero-apparel-1" | placeholder_svg_tag }}
        {% endif %}
    </div>
    <div class="hero-banner__text">
        <h1>{{ heading_text }}</h1>
        <p>{{ desciption_text }}</p>
    </div>
</div>

{% schema %}

{
    "name": "Hero Banner",
    "settings": [
        {
            "type": "text",
            "id": "heading_text",
            "label": "Heading Text",
            "default": "Heading Text"
        },
        {
            "type": "textarea",
            "id": "description_text",
            "label": "Description Text",
            "default": "Description Text"
        },
        {
            "type": "image_picker",
            "id": "banner_image",
            "label": "Banner Image",
        },
        {
            "type": "checkbox",
            "id": "full_width_section",
            "label": "Full Width Section",
            "default": false
        }
    ],
    "presets": [
        {
            "name": "Hero Banner",
            "settings": {
                "heading_text": "This is your awesome heading",
                "description_text": "This is your awesome explainer text.",
                "full_width_section": false
            }
        }
    ]
}

{% endschema %}